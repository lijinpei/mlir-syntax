node('build-machine') {
  git branch: 'rust', credentialsId: 'gituser', url: 'gituser@192.168.1.3:/home/gituser/repos/mlir-syntax.git'
  parallel(
    archlinux: {
      stage('build-archlinux-image') {
        sh("""#!/usr/bin/env bash
          python3 ci/serveur.py \
          --proxy http://127.0.0.1:7890 \
          build_docker_image \
          --distro archlinux \
          --llvm 20 \
          --registry 192.168.1.3:5000""")
      }
    },
    debian: {
      stage('build-debian-image') {
        sh("""#!/usr/bin/env bash
          python3 ci/serveur.py \
          --proxy http://127.0.0.1:7890 \
          build_docker_image \
          --distro debian \
          --llvm 20 \
          --registry 192.168.1.3:5000""")
      }
    })
}
